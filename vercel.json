{
  "buildCommand": "cd bioskopku-web && npm install && npm run build",
  "outputDirectory": "bioskopku-web/dist",
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
# =================================================================
# RuangSinema — Environment Variables Configuration
# Salin file ini menjadi .env pada environment deployment Anda
# =================================================================

# 1. Autentikasi & Sesi
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# 2. Verifikasi 2 Langkah (2FA / TOTP)
# Kunci enkripsi 32-byte (64 hex characters) untuk enkripsi secret TOTP di database (AES-256-GCM)
TOTP_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. Pengiriman Email (SMTP - Opsional, graceful fallback jika kosong)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RuangSinema Security" <security@ruangsinema.com>

# 4. Layanan Geolokasi IP (Opsional, bawaan menggunakan ipapi.co dengan fallback lokal)
GEOIP_TOKEN=

# 5. Database MySQL (Server Lokal / phpMyAdmin)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bioskopku_db

# 6. Lingkungan
NODE_ENV=production

# Kunci untuk endpoint admin (GET daftar user & POST /api/auth/sync).
# Wajib diisi di Vercel dan di server lokal; tanpa ini endpoint admin ditolak.
ADMIN_API_KEY=

# Daftar origin yang boleh memanggil API auth, dipisah koma.
AUTH_ALLOWED_ORIGINS=https://ruang-sinema.vercel.app,http://localhost:5173

# MySQL lokal (server/auth-server.js)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bioskopku_db
